 # ── Project / data artefacts ──────────────────────────────────────────────────
# Ignore all personal data but keep the directory scaffold so a fresh clone
# has the empty data/ tree the app expects.
data/*
!data/.gitkeep
!data/finetune/
!data/finetune/.gitkeep
!data/adapters/
!data/adapters/.gitkeep
data/finetune/*
!data/finetune/.gitkeep
data/adapters/*
!data/adapters/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Type checking / linting caches ───────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model weights (large files — use HF Hub or LFS) ──────────────────────────
*.gguf
*.bin
*.safetensors
*.pt
*.pth
models/

# ── Secrets / environment ─────────────────────────────────────────────────────
.env
*.key
*.pem

# ── macOS / editor ────────────────────────────────────────────────────────────
.DS_Store
.idea/
*.swp
*.swo

# ── VSCode ────────────────────────────────────────────────────────────────────
.vscode/settings.json    # keep extensions.json but not personal settings
!.vscode/extensions.json
!.vscode/launch.json

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── macOS AppleDouble metadata (created on non-native filesystems) ────────────
._*
.AppleDouble